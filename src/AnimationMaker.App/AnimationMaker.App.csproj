<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AnimationMaker</AssemblyName>
    <RootNamespace>AnimationMaker.App</RootNamespace>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon />
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AnimationMaker.Gpu/AnimationMaker.Gpu.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Vortice.WinUI" Version="3.8.3" />
    <Content Include="../../.tools/ffmpeg/ffmpeg.exe" Link="ffmpeg/ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../.tools/ffmpeg/ffprobe.exe" Link="ffmpeg/ffprobe.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../.tools/ffmpeg/LICENSE.txt" Link="ffmpeg/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../runtime/pixi-delta/dist/**/*" Link="delta-runtime/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WinUI marks compiled XAML as CopyToOutputDirectory, but the SDK publish pipeline
       does not automatically include these generated files in unpackaged apps. -->
  <Target Name="IncludeWinUiResourcesInPublish" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="Build">
    <ItemGroup>
      <_WinUiCompiledResource Include="$(TargetDir)$(TargetName).pri;$(TargetDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_WinUiCompiledResource)">
        <RelativePath>%(_WinUiCompiledResource.RecursiveDir)%(_WinUiCompiledResource.Filename)%(_WinUiCompiledResource.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
