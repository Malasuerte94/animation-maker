<Window x:Class="AnimationMaker.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Animation Maker">
  <Grid x:Name="Root" Background="#0C1119" RequestedTheme="Dark" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" KeyDown="OnKeyDown">
    <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="158"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="302"/></Grid.ColumnDefinitions>

    <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="22,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
          <Border Background="{StaticResource AccentBrush}" Width="38" Height="38" CornerRadius="10"><TextBlock Text="◈" Foreground="#12220C" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel><TextBlock Text="ANIMATION MAKER" FontSize="17" FontWeight="SemiBold" CharacterSpacing="90"/><TextBlock Text="Clean edges. Smaller assets." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
        </StackPanel>
        <TabView x:Name="WorkspaceTabs" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="44" TabWidthMode="SizeToContent" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" SelectionChanged="OnWorkspaceTabChanged">
          <TabViewItem Header="Editor" IsClosable="False"/>
          <TabViewItem Header="Player" IsClosable="False"/>
        </TabView>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="PixiJS runtime ↓" Click="OnSavePixiRuntime" ToolTipService.ToolTip="Save the reusable PixiJS delta animation plugin as a ZIP"/>
          <StackPanel x:Name="EditorCommands" Orientation="Horizontal" Spacing="8">
          <Button x:Name="UndoButton" Content="Undo" Click="OnUndo" IsEnabled="False" ToolTipService.ToolTip="Ctrl+Z"/>
          <Button x:Name="RedoButton" Content="Redo" Click="OnRedo" IsEnabled="False" ToolTipService.ToolTip="Ctrl+Y"/>
          <Button x:Name="SaveButton" Content="Save project" Click="OnSaveProject" IsEnabled="False"/>
          <Button x:Name="OpenButton" Content="＋  Open media" Click="OnOpen" Background="{StaticResource AccentBrush}" Foreground="#13210D" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="KeyingSidebar" Grid.Row="1" Grid.RowSpan="2" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0" Background="{StaticResource PanelBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <UserControl x:Name="KeyingPanel" IsEnabled="False"><StackPanel Padding="18,20" Spacing="15">
          <Grid><TextBlock Text="KEYING" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" CharacterSpacing="100"/><ToggleSwitch x:Name="KeyEnabled" HorizontalAlignment="Right" Toggled="OnSettingChanged" IsOn="True" MinWidth="0"/></Grid>
          <ComboBox x:Name="KeyMode" Header="Processing mode" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged"><ComboBoxItem Content="Quality · color difference"/><ComboBoxItem Content="Fast · chroma distance"/></ComboBox>
          <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ScreenColor" Header="Screen color" Text="#00FF00" LostFocus="OnSettingChanged"/><Button Grid.Column="1" Content="⌖" VerticalAlignment="Bottom" Click="OnEyedropper" ToolTipService.ToolTip="Pick screen color from the source"/></Grid>
          <Button Content="Auto sample green" HorizontalAlignment="Stretch" Click="OnAutoSample"/>
          <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PlateButton" Content="Load clean plate…" HorizontalAlignment="Stretch" Click="OnLoadPlate"/><Button Grid.Column="1" Content="×" Click="OnClearPlate" ToolTipService.ToolTip="Clear clean plate"/></Grid>
          <TextBlock x:Name="PlateLabel" Text="Optional background image, without the subject" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          <StackPanel x:Name="FastControls" Spacing="5" Visibility="Collapsed"><TextBlock Text="Chroma tolerance" FontSize="12"/><Slider x:Name="Similarity" Minimum="0" Maximum="0.6" Value="0.1" StepFrequency="0.005" ValueChanged="OnSettingChanged"/><TextBlock Text="Chroma softness" FontSize="12"/><Slider x:Name="Softness" Minimum="0.005" Maximum="0.6" Value="0.12" StepFrequency="0.005" ValueChanged="OnSettingChanged"/></StackPanel>
          <StackPanel Spacing="4"><TextBlock Text="Black clip · remove background" FontSize="12"/><Slider x:Name="BlackClip" Minimum="0" Maximum="0.45" Value="0.015" StepFrequency="0.005" ValueChanged="OnSettingChanged"/><TextBlock Text="White clip · solid foreground" FontSize="12"/><Slider x:Name="WhiteClip" Minimum="0.5" Maximum="1" Value="0.98" StepFrequency="0.005" ValueChanged="OnSettingChanged"/></StackPanel>
          <StackPanel Spacing="4"><TextBlock Text="Despill · remove green contamination" FontSize="12"/><Slider x:Name="Despill" Minimum="0" Maximum="1" Value="1" StepFrequency="0.01" ValueChanged="OnSettingChanged"/></StackPanel>
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><NumberBox x:Name="RedWeight" Header="Red weight" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.05" ValueChanged="OnSettingChanged"/><NumberBox Grid.Column="1" x:Name="BlueWeight" Header="Blue weight" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.05" ValueChanged="OnSettingChanged"/></Grid>
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><NumberBox x:Name="Choke" Header="Choke / expand" Minimum="-4" Maximum="4" Value="0" SmallChange="1" ValueChanged="OnSettingChanged"/><NumberBox Grid.Column="1" x:Name="Feather" Header="Feather px" Minimum="0" Maximum="2.5" Value="0" SmallChange="0.25" ValueChanged="OnSettingChanged"/></Grid>
          <Border Height="1" Background="{StaticResource StrokeBrush}"/>
          <TextBlock Text="CORRECTION MASKS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70"/>
          <ComboBox x:Name="MaskType" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="Keep · protect foreground"/><ComboBoxItem Content="Remove · garbage matte"/></ComboBox>
          <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="DrawMaskButton" Content="Draw polygon" Click="OnDrawMask" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="✓" Click="OnApplyMask" ToolTipService.ToolTip="Apply polygon / add keyframe"/></Grid>
          <TextBlock x:Name="MaskHint" Text="Click to place vertices. ✓ applies the mask. Select a mask to edit it at another time." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          <ListView x:Name="MaskList" MaxHeight="130" DisplayMemberPath="Name" SelectionChanged="OnMaskSelection"/>
          <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Edit / keyframe" Click="OnEditMask" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="Delete" Click="OnDeleteMask" HorizontalAlignment="Stretch"/></Grid>
        </StackPanel></UserControl>
      </ScrollViewer>
    </Border>

    <Grid x:Name="EditorPreview" Grid.Row="1" Grid.Column="1" Margin="16,14,16,0">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="55"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SourceTitle" Text="PREVIEW" FontSize="12" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" CharacterSpacing="70" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" x:Name="BackToOriginalButton" Content="← Back to original" Visibility="Collapsed" Click="OnBackToOriginal" Foreground="{StaticResource AccentBrush}" ToolTipService.ToolTip="Return to the original clip and editing settings · Esc"/><ComboBox Grid.Column="2" x:Name="PreviewResolution" SelectedIndex="0" SelectionChanged="OnPreviewResolutionChanged" MinWidth="125"><ComboBoxItem Content="Proxy · 1080p"/><ComboBoxItem Content="Full resolution"/></ComboBox></Grid>
      <Border Grid.Row="1" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Background="#0C121B">
        <Grid x:Name="Viewport" SizeChanged="OnViewportSizeChanged">
          <SwapChainPanel x:Name="PreviewSurface" Loaded="OnPreviewLoaded"/>
          <Canvas x:Name="MaskOverlay" Background="Transparent" PointerPressed="OnPreviewPointerPressed" PointerMoved="OnPreviewPointerMoved" PointerReleased="OnPreviewPointerReleased" PointerCanceled="OnPreviewPointerCanceled" PointerCaptureLost="OnPreviewPointerCaptureLost"/>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="13" IsHitTestVisible="False">
            <TextBlock Text="◈" FontSize="70" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Your next animation starts here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Drop an MP4, MOV, WebM or exported atlas&#10;—or use Open media above" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center"/>
            <Border Background="#1C2935" CornerRadius="6" Padding="12,7" HorizontalAlignment="Center"><TextBlock Text="LOCAL PROCESSING  ·  GPU ACCELERATED" FontSize="10" CharacterSpacing="70" Foreground="{StaticResource MutedBrush}"/></Border>
          </StackPanel>
          <Border x:Name="PickBanner" Background="#E022321A" CornerRadius="6" Padding="12,8" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12" Visibility="Collapsed"><TextBlock Text="Click the green screen to sample its color · Esc cancels" Foreground="{StaticResource AccentBrush}" FontSize="12"/></Border>
          <Border x:Name="CropBanner" Background="#DF162531" CornerRadius="6" Padding="12,8" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="Drag handles to resize · drag inside to move · Enter / Esc finishes" TextWrapping="Wrap" FontSize="11"/></Border>
        </Grid>
      </Border>
      <Grid Grid.Row="2" VerticalAlignment="Center" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="BackgroundChoice" SelectedIndex="0" SelectionChanged="OnViewChanged" MinWidth="120"><ComboBoxItem Content="Checkerboard"/><ComboBoxItem Content="White"/><ComboBoxItem Content="Black"/><ComboBoxItem Content="Magenta"/><ComboBoxItem Content="Alpha matte"/><ComboBoxItem Content="Image background"/></ComboBox><Button Grid.Column="1" Content="Image…" Click="OnChooseBackgroundImage" ToolTipService.ToolTip="Load a photo behind the video · preview only"/><ComboBox Grid.Column="2" x:Name="BackgroundFitChoice" SelectedIndex="0" SelectionChanged="OnViewChanged" HorizontalAlignment="Left" MinWidth="75" Visibility="Collapsed" ToolTipService.ToolTip="Fill crops the image to cover the frame. Fit shows the entire image."><ComboBoxItem Content="Fill"/><ComboBoxItem Content="Fit"/></ComboBox><CheckBox Grid.Column="3" x:Name="ShowSource" Content="Source" Checked="OnViewChanged" Unchecked="OnViewChanged"/><ComboBox Grid.Column="4" x:Name="ZoomChoice" SelectedIndex="0" SelectionChanged="OnViewChanged" MinWidth="80"><ComboBoxItem Content="Fit"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/></ComboBox></Grid>
    </Grid>

    <Border x:Name="ExportSidebar" Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1,0,0,0" Background="{StaticResource PanelBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><UserControl x:Name="ExportPanel" IsEnabled="False"><StackPanel Padding="18,20" Spacing="16">
        <UserControl x:Name="ExportSettingsPanel"><StackPanel Spacing="16">
        <TextBlock Text="OUTPUT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" CharacterSpacing="100"/>
        <TextBlock x:Name="MediaInfo" Text="No clip loaded" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
        <NumberBox x:Name="FpsInput" Header="Frames per second" Minimum="1" Maximum="240" Value="30" ValueChanged="OnSettingChanged"/>
        <NumberBox x:Name="HeightInput" Header="Maximum frame height · px" Minimum="1" Maximum="16384" Value="512" ValueChanged="OnSettingChanged"/>
        <TextBlock x:Name="OutputSizeLabel" Text="Original canvas · aspect ratio preserved" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
        <Expander Header="Crop canvas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="8">
            <CheckBox x:Name="CropEnabled" Content="Enable crop" Checked="OnCropEnabledChanged" Unchecked="OnCropEnabledChanged"/>
            <Button x:Name="EditCropButton" Content="Adjust on video" HorizontalAlignment="Stretch" Click="OnEditCrop"/>
            <TextBlock Text="Resize with the 8 handles. Drag inside to move, or outside the selection to draw a new rectangle." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><NumberBox x:Name="CropX" Header="X" Minimum="0" Value="0" ValueChanged="OnSettingChanged"/><NumberBox Grid.Column="1" x:Name="CropY" Header="Y" Minimum="0" Value="0" ValueChanged="OnSettingChanged"/></Grid>
            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><NumberBox x:Name="CropWidth" Header="Width" Minimum="1" Value="1920" ValueChanged="OnSettingChanged"/><NumberBox Grid.Column="1" x:Name="CropHeight" Header="Height" Minimum="1" Value="1080" ValueChanged="OnSettingChanged"/></Grid>
            <Button Content="Reset to full frame" Click="OnResetCrop" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Expander>
        <Border Height="1" Background="{StaticResource StrokeBrush}"/>
        <TextBlock Text="SPRITESHEET" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70"/>
        <ComboBox x:Name="AtlasLayoutChoice" Header="Layout" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged"><ComboBoxItem Content="Packed atlas · trimmed"/><ComboBoxItem Content="Classic grid · equal cells"/></ComboBox>
        <ComboBox x:Name="AtlasSizeChoice" Header="Maximum atlas page" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged"><ComboBoxItem Content="2048 × 2048"/><ComboBoxItem Content="4096 × 4096"/><ComboBoxItem Content="8192 × 8192"/></ComboBox>
        <ComboBox x:Name="AtlasFormatChoice" Header="Atlas image format" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged"><ComboBoxItem Content="WebP · smaller files"/><ComboBoxItem Content="PNG · lossless"/></ComboBox>
        <NumberBox x:Name="WebpQualityInput" Header="WebP quality · 1–100" Minimum="1" Maximum="100" Value="75" SmallChange="1" ValueChanged="OnSettingChanged"/>
        <TextBlock Text="75 = medium (default). Lower values make smaller files; higher values keep more detail. Applies to spritesheet and delta pages; transparency is preserved." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
        <CheckBox x:Name="Deduplicate" Content="Reuse identical frames" IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
        <TextBlock Text="WebP / PNG RGBA + PixiJS / Phaser JSON&#10;2 px padding · 1 px edge extrusion" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
        <Button x:Name="AtlasExportButton" Content="Export spritesheet" Background="{StaticResource AccentBrush}" Foreground="#13210D" FontWeight="SemiBold" HorizontalAlignment="Stretch" Click="OnExportAtlas"/>
        <NumberBox x:Name="DeltaToleranceInput" Header="Delta tolerance · 0–32" Minimum="0" Maximum="32" Value="8" SmallChange="1" ValueChanged="OnSettingChanged"/>
        <ComboBox x:Name="DeltaAnalysisChoice" Header="Delta analysis" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="CPU"/><ComboBoxItem Content="GPU"/></ComboBox>
        <TextBlock Text="Auto measures analysis speed. CPU/GPU applies to Delta analysis; keying stays GPU accelerated." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        <TextBlock x:Name="DeltaBackendLabel" Text="Analysis backend is shown during export." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        <TextBlock Text="0 = exact patch selection. 8 = medium tolerance for video noise. Higher values make smaller patches. WebP adds color compression; use PNG + tolerance 0 for exact RGBA." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        <Button x:Name="DeltaPreviewButton" Content="Preview delta · 1 second" HorizontalAlignment="Stretch" Click="OnPreviewDelta"/>
        <Button x:Name="DeltaExportButton" Content="Export Delta Animation · BETA" HorizontalAlignment="Stretch" Click="OnExportDelta"/>
        <TextBlock Text="Exports WebP/PNG pages + delta.animation.json. Download the PixiJS runtime separately with the button above. Use Player to test exports." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        <Border Height="1" Background="{StaticResource StrokeBrush}"/>
        <TextBlock Text="WEBM + ALPHA" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70"/>
        <ComboBox x:Name="VideoQualityChoice" Header="VP9 encoding" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnSettingChanged"><ComboBoxItem Content="High quality"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Smaller file"/><ComboBoxItem Content="Lossless encoding"/></ComboBox>
        <CheckBox x:Name="IncludeAudio" Content="Keep audio · Opus" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
        <Button x:Name="WebmExportButton" Content="Export transparent WebM" HorizontalAlignment="Stretch" Click="OnExportWebm"/>
        </StackPanel></UserControl>
        <ProgressBar x:Name="ExportProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed"/>
        <TextBlock x:Name="ExportStage" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        <Button x:Name="CancelExportButton" Content="Cancel export" Visibility="Collapsed" Click="OnCancelExport" HorizontalAlignment="Stretch"/>
        <Button x:Name="OpenExportButton" Content="Play last export" IsEnabled="False" Click="OnPlayExport" HorizontalAlignment="Stretch"/>
        <CheckBox x:Name="ChangedRegions" Content="Show changed regions" Visibility="Collapsed" Checked="OnChangedRegions" Unchecked="OnChangedRegions"/>
        <TextBlock x:Name="DeltaReportLabel" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        <Button x:Name="BackToOriginalExportButton" Content="← Back to original" Visibility="Collapsed" Click="OnBackToOriginal" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Stretch"/>
        <Grid x:Name="BackgroundImageDetails" Visibility="Collapsed" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="BackgroundImageLabel" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="×" Click="OnClearBackgroundImage" ToolTipService.ToolTip="Remove preview background image"/></Grid>
      </StackPanel></UserControl></ScrollViewer>
    </Border>

    <Border x:Name="EditorTimeline" Grid.Row="2" Grid.Column="1" Margin="16,0,16,10" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Background="{StaticResource PanelBrush}" Padding="12,10">
      <UserControl x:Name="TimelinePanel" IsEnabled="False"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="45"/><RowDefinition Height="26"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="│◀" Padding="8,4" Click="OnPreviousFrame"/><Button Grid.Column="1" x:Name="PlayButton" Content="▶  Play" Padding="12,4" Click="OnPlay"/><Button Grid.Column="2" Content="▶│" Padding="8,4" Click="OnNextFrame"/><TextBlock Grid.Column="3" x:Name="TimeLabel" Text="00:00.000" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0"/><CheckBox Grid.Column="4" x:Name="LoopToggle" Content="Loop" IsChecked="True" MinWidth="0"/><ComboBox Grid.Column="5" x:Name="SpeedChoice" SelectedIndex="2" MinWidth="72"><ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/></ComboBox></Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0"><StackPanel x:Name="Filmstrip" Orientation="Horizontal" Spacing="2"/></ScrollViewer>
        <Grid Grid.Row="2"><Canvas x:Name="KeyframeMarkers" IsHitTestVisible="False"/><Slider x:Name="PositionSlider" Minimum="0" Maximum="1" StepFrequency="0.033333" ValueChanged="OnPositionChanged"/></Grid>
        <Grid Grid.Row="3" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="SetInButton" Content="[ Set in" FontSize="11" Padding="8,1" Click="OnSetIn"/><TextBlock x:Name="InLabel" Grid.Column="1" Text="0.000s" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock x:Name="OutLabel" Grid.Column="3" Text="0.000s" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button x:Name="SetOutButton" Grid.Column="4" Content="Set out ]" FontSize="11" Padding="8,1" Click="OnSetOut"/></Grid>
      </Grid></UserControl>
    </Border>
    <Grid x:Name="PlayerWorkspace" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="18,14,18,14" ColumnSpacing="18" RowSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="284"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="108"/></Grid.RowDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="PlayerTitle" Text="PLAYER" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        <Border Grid.Row="1" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Background="#0C121B">
          <Grid x:Name="PlayerViewport" SizeChanged="OnPlayerViewportSizeChanged">
            <SwapChainPanel x:Name="PlayerSurface" Loaded="OnPlayerSurfaceLoaded"/>
            <StackPanel x:Name="PlayerEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" IsHitTestVisible="False">
              <TextBlock Text="▷" FontSize="70" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="Play your exported animations" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="Drop an export folder or animation JSON here&#10;Delta · spritesheets · WebM · images" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Column="1" Grid.RowSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16">
          <TextBlock Text="ANIMATION PLAYER" FontSize="12" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{StaticResource MutedBrush}"/>
          <Button Content="Open exported file…" Click="OnOpenPlayerFile" HorizontalAlignment="Stretch" Background="{StaticResource AccentBrush}" Foreground="#13210D" FontWeight="SemiBold"/>
          <Button Content="Open export folder…" Click="OnOpenPlayerFolder" HorizontalAlignment="Stretch"/>
          <TextBlock x:Name="PlayerInfoLabel" Text="Open delta.animation.json or animation.json to play the animation. A WebP/PNG page on its own opens as an image." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          <Border Height="1" Background="{StaticResource StrokeBrush}"/>
          <NumberBox x:Name="PlayerFreezeFrame" Header="Freeze at frame · starts at 0" Minimum="0" Maximum="0" Value="0" SmallChange="1" IsEnabled="False" ValueChanged="OnPlayerFreezeFrameChanged"/>
          <TextBlock Text="Scrub or enter a frame to pause there. Space plays/pauses; arrow keys step one frame." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          <ComboBox x:Name="PlayerBackgroundChoice" Header="Background" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnPlayerViewChanged"><ComboBoxItem Content="Checkerboard"/><ComboBoxItem Content="White"/><ComboBoxItem Content="Black"/><ComboBoxItem Content="Magenta"/><ComboBoxItem Content="Alpha matte"/></ComboBox>
          <ComboBox x:Name="PlayerZoomChoice" Header="Zoom" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnPlayerViewChanged"><ComboBoxItem Content="Fit"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/></ComboBox>
          <Border Height="1" Background="{StaticResource StrokeBrush}"/>
          <TextBlock Text="PIXIJS INTEGRATION" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock Text="One reusable plugin for all delta animations. Supports play, pause, loop, speed and freezing at any frame." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          <Button Content="Download PixiJS runtime…" Click="OnSavePixiRuntime" HorizontalAlignment="Stretch"/>
        </StackPanel></ScrollViewer>
      </Border>
      <Border Grid.Row="1" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Background="{StaticResource PanelBrush}" Padding="14,10">
        <UserControl x:Name="PlayerTransport" IsEnabled="False"><StackPanel Spacing="8">
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="│◀" Click="OnPlayerPreviousFrame"/><Button Grid.Column="1" x:Name="PlayerPlayButton" Content="▶  Play" Click="OnPlayerPlay"/><Button Grid.Column="2" Content="▶│" Click="OnPlayerNextFrame"/>
            <TextBlock Grid.Column="3" x:Name="PlayerTimeLabel" Text="No animation loaded" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
            <CheckBox Grid.Column="4" x:Name="PlayerLoopToggle" Content="Loop" IsChecked="True"/>
            <ComboBox Grid.Column="5" x:Name="PlayerSpeedChoice" SelectedIndex="2" MinWidth="74"><ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/></ComboBox>
          </Grid>
          <Slider x:Name="PlayerPositionSlider" Minimum="0" Maximum="1" StepFrequency="1" ValueChanged="OnPlayerPositionChanged"/>
        </StackPanel></UserControl>
      </Border>
    </Grid>
    <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#111721" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="18,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="Ready · open a clip to begin" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="GpuLabel" Grid.Column="1" Text="DIRECT3D 11" FontSize="10" CharacterSpacing="60" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
</Window>
